{
  "name": "reg-compare",
  "version": "0.1.0",
  "description": "Evidence-backed regulatory document comparison harness",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration && npm run test:sanity",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "tsx src/cli.ts",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:sanity": "tsx test/sanity.ts",
    "test:sanity:full": "tsx test/sanity.ts --full"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.10",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-sdk": "1.9.23",
    "commander": "13.1.0",
    "deepagents": "1.13.1",
    "langchain": "1.5.10",
    "langsmith": "0.9.0",
    "pdfjs-dist": "4.10.38",
    "quickjs-emscripten": "0.32.0",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "type": "module",
  "private": true,
  "bin": {
    "reg-compare": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.1.0 <23"
  }
}

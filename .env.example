# Copy to .env and fill in. .env is gitignored.
# Any OpenAI-compatible endpoint works. REG_COMPARE_PROVIDER_ORDER is always required (it is
# recorded as run provenance) but is only forwarded as routing when the base URL is OpenRouter.

# --- OpenRouter ---
OPENROUTER_API_KEY=
REG_COMPARE_PROVIDER_ORDER=GMICloud
REG_COMPARE_MODEL=minimax/minimax-m3:free

# --- Groq (alternative) ---
# REG_COMPARE_API_KEY=
# REG_COMPARE_BASE_URL=https://api.groq.com/openai/v1
# REG_COMPARE_MODEL=openai/gpt-oss-20b
# REG_COMPARE_PROVIDER_ORDER=groq
